# Supabase (pre-populated — do not change)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================
# Offer Provider Credentials
# ============================================================
# These are stored encrypted in the database via the admin panel.
# Do NOT put provider secrets in .env — use the admin panel
# "Offers > Providers" section to set them securely.
#
# Below are the credentials each supported provider requires.
# Only configure providers you have an account with.
#
# --- AdGem (https://adgem.com) ---
# Required in admin panel:
#   API Key:        Your AdGem API key
#   Postback Secret: Your AdGem security token
#   Publisher ID:   Your AdGem publisher/affiliate ID
# Postback URL to give AdGem:
#   https://<your-project>.supabase.co/functions/v1/offer-webhook/adgem
#
# --- OfferToro (https://offertoro.com) ---
# Required in admin panel:
#   API Key:        Your OfferToro API key
#   Postback Secret: Your OfferToro secret key
#   Publisher ID:   Your OfferToro publisher ID
# Postback URL:
#   https://<your-project>.supabase.co/functions/v1/offer-webhook/offertoro
#
# --- CPX Research (https://cpx-research.com) ---
# Required in admin panel:
#   API Key:        Your CPX API key
#   Postback Secret: Your CPX secret/hash key
#   Publisher ID:   Your CPX publisher ID
# Postback URL:
#   https://<your-project>.supabase.co/functions/v1/offer-webhook/cpx_research
#
# --- BitLabs (https://bitlabs.ai) ---
# Required in admin panel:
#   API Key:        Your BitLabs API key
#   Postback Secret: Your BitLabs secret key
#   Publisher ID:   Your BitLabs publisher ID
# Postback URL:
#   https://<your-project>.supabase.co/functions/v1/offer-webhook/bitlabs
#
# --- MyLead (https://mylead.global) ---
# Required in admin panel:
#   API Key:        Your MyLead API key
#   Postback Secret: Your MyLead security token
#   Publisher ID:   Your MyLead affiliate ID
# Postback URL:
#   https://<your-project>.supabase.co/functions/v1/offer-webhook/mylead
#
# ============================================================
# Encryption key for provider secrets
# Set via the Supabase SQL editor/CLI:
#   ALTER DATABASE postgres SET app.secret_key TO 'a-long-random-32+-char-secret';
# Generate with: openssl rand -base64 32
# Must never be a VITE_* variable.
# ============================================================
